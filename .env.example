# Stripe 秘密鍵（サーバ専用。Git にコミットしないこと）
# 必ず「変数名=値」の形式で書いてください。キーだけを1行に置いても読み込まれません。
STRIPE_SECRET_KEY=sk_test_xxxxxxxx

# 公開可能キー（pk_test_... / NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY）は不要です。
# このアプリは Stripe Checkout（ホスト型の決済ページへリダイレクト）のため、
# クライアントに公開鍵を渡したり、Stripe.js を埋め込んだりしません。

# 任意: サイトの公開URL（OGP・絶対URLの生成に使用）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
